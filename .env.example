# Internet Search Skill - API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Firecrawl - Web scraping and content extraction
# Sign up: https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# Brave Search - Privacy-focused search
# Sign up: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# Serper - Google search results via API
# Sign up: https://serper.dev
SERPER_API_KEY=your-serper-api-key-here

# Google Custom Search Engine
# Setup: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-search-engine-id-here

# DuckDuckGo - No API key needed (can be used directly)

# Note: Not all API keys are required. The skill will use available tools.
# At minimum, you can use the built-in WebSearch without any API keys.
